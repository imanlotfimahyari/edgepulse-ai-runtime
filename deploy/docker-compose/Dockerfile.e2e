FROM python:3.12-slim

WORKDIR /app

COPY simulators/requirements.txt /tmp/simulator-requirements.txt

RUN pip install --no-cache-dir \
    -r /tmp/simulator-requirements.txt

COPY simulators ./simulators
COPY scripts/e2e_compose.py ./scripts/e2e_compose.py

ENV PYTHONPATH=/app

CMD ["python", "scripts/e2e_compose.py"]
